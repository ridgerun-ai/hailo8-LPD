import argparse

from web_model_server.algorithm.video import VideoProcessor


def main():

    parser = argparse.ArgumentParser(description='Video Blurring')
    parser.add_argument('-i', '--input', help='Input Video')
    parser.add_argument('-o', '--output', help='Output Video')
    args = parser.parse_args()

    video_processor = VideoProcessor()

    video_processor.apply(args.input, args.output)


if __name__ == '__main__':
    main()
